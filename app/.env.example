# FormSubmit form ID (from https://formsubmit.co)
VITE_FORM_SUBMIT_ID=your_formsubmit_id_here

# Shown in error fallback mailto link only (set in host env vars for production)
VITE_CONTACT_EMAIL=your-email@example.com

# Production site URL (no trailing slash) — used for sitemap.xml and og:image at build time
VITE_SITE_URL=https://your-domain.com
